STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here
STRIPE_DOMAIN=https://your-domain.web.app

# --- Furniture image search (Google Custom Search) ---
# Free tier: 100 queries/day. Results cached 30 days in Firestore.
# Setup:
#   1. https://programmablesearchengine.google.com → create an engine,
#      "Search the entire web" + Image search ON. Copy the Search engine ID.
#   2. https://console.cloud.google.com → enable "Custom Search API" + create an API key.
# Either set these env vars locally OR run:
#   firebase functions:config:set google_cse.key="..." google_cse.cx="..."
GOOGLE_CSE_KEY=your_custom_search_api_key
GOOGLE_CSE_CX=your_search_engine_id
